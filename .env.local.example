# Copy this file to .env.local (gitignored) and fill in real values from
# your Supabase project: Project Settings -> API.
#
# NEXT_PUBLIC_* variables are sent to the browser. Never put the secret key
# (sb_secret_..., formerly called service_role) in this file or anywhere
# client-exposed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
